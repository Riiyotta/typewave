  "responsive": [
    {
      "breakpoint": "desktop",
      "query": "(min-width: 1025px)",
      "changes": {
        "sectionHeight": "calc(100vh + 400px)",
        "stage": "sticky 100vh",
        "scrub": "section progress, frames over 0.2-0.8",
        "captions": "absolute, slide up 0.6vh over 2nd half",
        "simulatorSizePx": [
          312,
          424
        ]
      },
      "measuredFrom": [
        {
          "cite": "src/components/Breakpoint.jsx:51",
          "expect": "style={{ height: `calc(100vh + ${TOTAL_FRAMES * 8}px)` }}"
        },
        {
          "cite": "src/index.css:230",
          "expect": ".breakpoint__sticky{position:sticky;top:0;width:100%;height:100vh"
        },
        {
          "cite": "CLONE_SPEC.md:348",
          "expect": "Size at 1440: 312x424"
        }
      ]
    },
    {
      "breakpoint": "tablet",
      "query": "(max-width: 1024px)",
      "changes": {
        "sectionHeight": "auto",
        "stage": "static",
        "scrub": "mockup in-view progress",
        "captions": "static, stacked below",
        "gapPx": 60
      },
      "measuredFrom": [
        {
          "cite": "src/index.css:238",
          "expect": ".breakpoint{height:auto!important"
        },
        {
          "cite": "src/index.css:240",
          "expect": ".breakpoint__caption,.breakpoint__caption-left{position:static;width:100%;transform:none!important;margin-top:24px}"
        }
      ]
    },
    {
      "breakpoint": "mobile",
      "query": "(max-width: 767px)",
      "changes": {
        "gapPx": 40
      },
      "measuredFrom": [
        {
          "cite": "src/index.css:242",
          "expect": "@media (max-width: 767px){.breakpoint{gap:40px}}"
        }
      ]
    }
  ],
  "accessibility": "The mockup is aria-hidden; the simulator select has an accessible label (\"Desktop font size\").",
