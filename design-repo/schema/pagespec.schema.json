{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "typewave-design-repo/pagespec.schema.json",
  "title": "Typewave PageSpec",
  "description": "Machine contract for one generated page. Closed template and section enums, additionalProperties:false everywhere, per-section content and motion contracts. What JSON Schema cannot express is enforced by semantic_validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageSpecVersion",
    "template",
    "route",
    "theme",
    "meta",
    "nodes"
  ],
  "properties": {
    "pageSpecVersion": {
      "const": "1.0.0"
    },
    "template": {
      "enum": [
        "template.home"
      ]
    },
    "route": {
      "type": "string",
      "pattern": "^/[a-z0-9/-]*$"
    },
    "theme": {
      "enum": [
        "typewave-dark"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "$ref": "#/definitions/text"
        },
        "ogImage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "assetRef"
          ],
          "properties": {
            "assetRole": {
              "allOf": [
                {
                  "$ref": "#/definitions/assetRole"
                },
                {
                  "const": "meta.og-image"
                }
              ]
            },
            "assetRef": {
              "$ref": "#/definitions/assetRef"
            }
          }
        },
        "favicon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "assetRef"
          ],
          "properties": {
            "assetRole": {
              "allOf": [
                {
                  "$ref": "#/definitions/assetRole"
                },
                {
                  "const": "meta.favicon"
                }
              ]
            },
            "assetRef": {
              "$ref": "#/definitions/assetRef"
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[^\\[\\]|]+|\\||\\[[^\\[\\]|]+\\])+$",
      "$comment": "Clone mini-syntax: | forced break, [..] brand span (src/lib/compose.jsx)."
    },
    "href": {
      "type": "string",
      "pattern": "^(#[a-z][a-z0-9-]*|/[^\\s]*|https://[^\\s]+|mailto:[^\\s@]+@[^\\s@]+)$"
    },
    "anchorTarget": {
      "type": "string",
      "pattern": "^#[a-z][a-z0-9-]*$"
    },
    "anchorId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "assetRole": {
      "enum": [
        "brand.logo-mark",
        "brand.logo-wordmark",
        "icon.figma-glyph",
        "logo.third-party-tool",
        "media.export-screenshot",
        "media.faq-screenshot",
        "media.figma-panel",
        "media.hero-video",
        "media.step-video",
        "meta.favicon",
        "meta.og-image"
      ]
    },
    "assetRef": {
      "type": "string",
      "pattern": "^(asset|generated|owner-supplied):[a-z0-9][a-z0-9-]*$"
    },
    "figmaCta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "$ref": "#/definitions/text"
        },
        "href": {
          "$ref": "#/definitions/href"
        },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "assetRef"
          ],
          "properties": {
            "assetRole": {
              "allOf": [
                {
                  "$ref": "#/definitions/assetRole"
                },
                {
                  "const": "icon.figma-glyph"
                }
              ]
            },
            "assetRef": {
              "$ref": "#/definitions/assetRef"
            }
          }
        }
      }
    },
    "content.shell.navbar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logo",
        "logoLabel",
        "links",
        "cta"
      ],
      "properties": {
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "assetRef"
          ],
          "properties": {
            "assetRole": {
              "allOf": [
                {
                  "$ref": "#/definitions/assetRole"
                },
                {
                  "const": "brand.logo-wordmark"
                }
              ]
            },
            "assetRef": {
              "$ref": "#/definitions/assetRef"
            }
          }
        },
        "logoLabel": {
          "$ref": "#/definitions/text"
        },
        "links": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "target"
            ],
            "properties": {
              "label": {
                "$ref": "#/definitions/text"
              },
              "target": {
                "$ref": "#/definitions/anchorTarget"
              },
              "tag": {
                "enum": [
                  "NEW"
                ]
              }
            }
          }
        },
        "cta": {
          "$ref": "#/definitions/figmaCta"
        }
      }
    },
    "motion.shell.navbar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "nav-hide-on-scroll",
              "mobile-menu"
            ]
          }
        },
        "reducedMotionFallback": {
          "const": "instant-hide-show"
        },
        "revealDelaysMs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              0,
              100,
              150,
              200,
              300,
              450
            ]
          }
        }
      }
    },
    "content.hero.video-scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "cta",
        "video"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/title"
        },
        "subtitle": {
          "$ref": "#/definitions/text"
        },
        "cta": {
          "$ref": "#/definitions/figmaCta"
        },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "assetRef"
          ],
          "properties": {
            "assetRole": {
              "allOf": [
                {
                  "$ref": "#/definitions/assetRole"
                },
                {
                  "const": "media.hero-video"
                }
              ]
            },
            "assetRef": {
              "$ref": "#/definitions/assetRef"
            }
          }
        }
      }
    },
    "motion.hero.video-scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "char-reveal-scroll-linked",
              "fade-up",
              "parallax",
              "hero-video-scale",
              "video-play-once"
            ]
          }
        },
        "reducedMotionFallback": {
          "const": "static-full-scale-video"
        },
        "revealDelaysMs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              0,
              100,
              150,
              200,
              300,
              450
            ]
          }
        }
      }
    },
    "content.steps.sticky-stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "cards"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/title"
        },
        "cards": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "badge",
              "badgeTone",
              "title",
              "text",
              "video"
            ],
            "properties": {
              "badge": {
                "type": "string",
                "pattern": "^[1-9]$"
              },
              "badgeTone": {
                "enum": [
                  "brand",
                  "step-2",
                  "step-3"
                ]
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "text": {
                "$ref": "#/definitions/text"
              },
              "video": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assetRole",
                  "assetRef"
                ],
                "properties": {
                  "assetRole": {
                    "allOf": [
                      {
                        "$ref": "#/definitions/assetRole"
                      },
                      {
                        "const": "media.step-video"
                      }
                    ]
                  },
                  "assetRef": {
                    "$ref": "#/definitions/assetRef"
                  }
                }
              }
            }
          }
        }
      }
    },
    "motion.steps.sticky-stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "char-reveal-scroll-linked",
              "fade-up",
              "parallax",
              "sticky-stack-scale"
            ]
          }
        },
        "reducedMotionFallback": {
          "const": "static-unscaled-stack"
        },
        "revealDelaysMs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              0,
              100,
              150,
              200,
              300,
              450
            ]
          }
        }
      }
    },
    "content.cards.feature-carousel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "cards"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/title"
        },
        "cards": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "image",
              "title",
              "text"
            ],
            "properties": {
              "image": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assetRole",
                  "assetRef",
                  "alt"
                ],
                "properties": {
                  "assetRole": {
                    "allOf": [
                      {
                        "$ref": "#/definitions/assetRole"
                      },
                      {
                        "const": "media.figma-panel"
                      }
                    ]
                  },
                  "assetRef": {
                    "$ref": "#/definitions/assetRef"
                  },
                  "alt": {
                    "$ref": "#/definitions/text"
                  }
                }
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "text": {
                "$ref": "#/definitions/text"
              }
            }
          }
        }
      }
    },
    "motion.cards.feature-carousel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "char-reveal-scroll-linked",
              "fade-up",
              "swipe-carousel"
            ]
          }
        },
        "reducedMotionFallback": {
          "const": "instant-visible"
        },
        "revealDelaysMs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              0,
              100,
              150,
              200,
              300,
              450
            ]
          }
        }
      }
    },
    "content.showcase.breakpoint-scrub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "caption",
        "mockup",
        "simulator"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/title"
        },
        "caption": {
          "$ref": "#/definitions/text"
        },
        "mockup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headlineLines",
            "paragraph",
            "buttonLabel"
          ],
          "properties": {
            "headlineLines": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/definitions/text"
              }
            },
            "paragraph": {
              "$ref": "#/definitions/text"
            },
            "buttonLabel": {
              "$ref": "#/definitions/text"
            }
          }
        },
        "simulator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "defaultDesktopPx"
          ],
          "properties": {
            "defaultDesktopPx": {
              "enum": [
                10,
                11,
                12,
                13,
                14,
                15,
                16,
                17,
                18,
                20,
                22,
                24,
                26,
                28,
                30,
                32,
                36,
                40,
                44,
                48,
                52,
                56,
                60,
                64,
                68,
                72,
                80,
                88,
                96
              ]
            }
          }
        }
      }
    },
    "motion.showcase.breakpoint-scrub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "char-reveal-scroll-linked",
              "fade-up",
              "scrub-progress",
              "caption-slide-up"
            ]
          }
        },
        "reducedMotionFallback": {
          "const": "static-final-frame"
        },
        "revealDelaysMs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              0,
              100,
              150,
              200,
              300,
              450
            ]
          }
        }
      }
    },
    "content.grid.preset-wave": {
      "type": "object",
