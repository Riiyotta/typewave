                  "media-left",
                  "media-right"
                ]
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "tag": {
                "enum": [
                  "NEW"
                ]
              },
              "text": {
                "$ref": "#/definitions/text"
              },
              "image": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assetRole",
                  "assetRef",
                  "alt"
                ],
                "properties": {
                  "assetRole": {
                    "allOf": [
                      {
                        "$ref": "#/definitions/assetRole"
                      },
                      {
                        "const": "media.export-screenshot"
                      }
                    ]
                  },
                  "assetRef": {
                    "$ref": "#/definitions/assetRef"
                  },
                  "alt": {
                    "$ref": "#/definitions/text"
                  }
                }
              },
              "logos": {
                "type": "array",
                "minItems": 0,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "assetRole",
                    "assetRef",
                    "label"
                  ],
                  "properties": {
                    "assetRole": {
                      "allOf": [
                        {
                          "$ref": "#/definitions/assetRole"
                        },
                        {
                          "const": "logo.third-party-tool"
                        }
                      ]
                    },
                    "assetRef": {
                      "$ref": "#/definitions/assetRef"
                    },
                    "label": {
                      "$ref": "#/definitions/text"
                    }
                  }
                }
              },
              "anchorId": {
                "$ref": "#/definitions/anchorId"
              }
            }
          }
