              },
              "featured": {
                "type": "boolean"
              },
              "cta": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "href",
                  "variant"
                ],
                "properties": {
                  "label": {
                    "$ref": "#/definitions/text"
                  },
                  "href": {
                    "$ref": "#/definitions/href"
                  },
                  "variant": {
                    "enum": [
                      "brand",
                      "primary"
                    ]
                  }
                }
              }
            }
          }
        },
        "includes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "columns"
          ],
          "properties": {
            "title": {
              "$ref": "#/definitions/text"
            },
            "columns": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
