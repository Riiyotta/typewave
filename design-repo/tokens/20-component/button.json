          {
            "cite": "src/index.css:139",
            "expect": ".navbar__mobile-cta .btn{width:100%;justify-content:center;height:56px}"
          }
        ]
      }
    },
    "primary-bg": {
      "$value": "{color-roles.action.primary-bg}",
      "$type": "alias"
    },
    "primary-bg-hover": {
      "$value": "{color-roles.action.primary-bg-hover}",
      "$type": "alias"
    },
    "primary-text": {
      "$value": "{color-roles.action.primary-text}",
      "$type": "alias"
    },
    "brand-bg": {
      "$value": "{color-roles.action.brand-bg}",
      "$type": "alias"
    },
    "brand-text": {
      "$value": "{color-roles.action.brand-text}",
