{
  "component.button": {
    "height-sm": {
      "$value": "40px",
      "$type": "dimension",
      "$extensions": {
        "measuredFrom": [
          {
            "cite": "src/index.css:100",
            "expect": ".btn--sm{height:40px;padding:0 16px;border-radius:var(--radius-sm)}"
          }
        ]
      }
    },
    "padding-x-sm": {
      "$value": "16px",
      "$type": "dimension",
      "$extensions": {
        "measuredFrom": [
          {
            "cite": "src/index.css:100",
            "expect": ".btn--sm{height:40px;padding:0 16px"
          }
        ]
      }
    },
    "gap": {
      "$value": "8px",
      "$type": "dimension",
      "$extensions": {
        "measuredFrom": [
          {
            "cite": "src/index.css:99",
            "expect": ".btn{display:inline-flex;align-items:center;gap:8px"
          }
        ]
      }
    },
    "radius": {
      "$value": "{radius.sm}",
      "$type": "alias"
    },
    "height-plan": {
      "$value": "48px",
