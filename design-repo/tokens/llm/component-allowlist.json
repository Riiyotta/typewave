{
  "version": "1.0.0",
  "$description": "Closed set a generator may instantiate (sections, via PageSpec nodes) or that contracts compose (primitives/components). verify_all.py checks parity with the files on disk and with pagespec.schema.json in both directions.",
  "templates": [
    "template.home"
  ],
  "sections": [
    {
      "id": "shell.navbar",
      "file": "sections/shell.navbar.json",
      "purpose": "Persistent orientation and the primary install CTA: logo home link, in-page jumps to the four decision sections, one \"Try it now\" button; collapses to a full-screen menu on touch widths.",
      "variants": [],
      "settableProperties": [
        "cta",
        "links",
        "logo",
        "logoLabel"
      ],
      "motionFields": [
        "patterns",
        "reducedMotionFallback",
        "revealDelaysMs"
      ],
      "assetRoles": [
        "brand.logo-wordmark",
        "icon.figma-glyph"
      ]
    },
    {
      "id": "hero.video-scale",
      "file": "sections/hero.video-scale.json",
      "purpose": "Land the one-line promise (type scale without the math) and convert to install, then hand off to a product video that scales from 0.8 to full width as the visitor scrolls.",
