{
  "version": "1.0.0",
  "$description": "Closed asset-role vocabulary. Every PageSpec media field is {assetRole, assetRef[, alt|label]}; assetRole must be a settable role and the one the field expects (schema const); assetRef must use a prefix the role's policy allows. Non-settable roles exist so fonts, the Lottie ban and live endpoints are machine-checkable.",
  "sourceIsRealCompany": true,
  "licensing": {
    "summary": "Typewave (typewave.blendmodes.com) is a real, live, commercial site for a Figma plugin by Blend Modes. Its marks, product videos/screenshots, OG cover and marketing copy are proprietary; tool logos are third-party trademarks; Roobert/Vesterbro (and the GT Super Display glyphs inside the Lottie) are commercial fonts; checkout/newsletter/plugin/mailbox/legal URLs are live endpoints. The clone (and this design-repo's example) uses ORIGINAL PLACEHOLDER copy written fresh in src/content.js, never the live copy.",
    "forbidden": [
      "reproducing, tracing or AI-generating the Typewave / Blend Modes mark or favicon",
      "AI-generating, redrawing or imitating any third-party logo (Figma, Cursor, VS Code, Claude, OpenAI, Lovable)",
      "reusing the original videos, screenshots or OG cover in any generated page (only newly generated stand-ins)",
      "reusing recon-assets/breakpoint-lottie.json (it embeds the original copy as glyphs)",
      "shipping or generating Roobert / Vesterbro / GT Super Display font files",
      "emitting the live checkout, newsletter, plugin, mailbox, legal or affiliate endpoints",
      "transcribing the live site's marketing copy"
    ]
  },
  "policies": {
    "must-not-reproduce": {
      "description": "The real company's own mark (Blend Modes / Typewave). Never reproduce, redraw, trace or AI-generate it or a look-alike. A page owner supplies their OWN mark through an owner-supplied slot.",
      "allowedRefPrefixes": [
        "owner-supplied"
      ]
    },
    "must-not-fabricate": {
      "description": "A third-party trademark (Figma, Cursor, VS Code, Claude, OpenAI, Lovable). Never AI-generate, redraw or imitate it. Only the official asset, obtained by the page owner from the mark owner under its brand guidelines, may fill an owner-supplied slot; otherwise omit it.",
      "allowedRefPrefixes": [
        "owner-supplied"
      ]
    },
    "generated-stand-in-only": {
      "description": "The real company's proprietary product media (videos, screenshots, OG cover). Generated pages may only use NEWLY GENERATED stand-ins (assetRef generated:<slot>) that do not depict the original UI, people or logos. The original files are registered only so they can be recognised and rejected.",
      "allowedRefPrefixes": [
        "generated"
      ]
    },
    "html-rebuild-only": {
      "description": "Render from PageSpec copy with HTML/CSS (the BreakpointMock rebuild). The original Lottie JSON must never be reused: it embeds the original marketing copy as glyph shapes and GT Super Display glyph outlines.",
      "allowedRefPrefixes": []
    },
    "licensed-font-required": {
      "description": "Commercial typeface. Reference it by family name only; the deployer must hold a licence. Font files are never shipped in this design-repo or generated.",
      "allowedRefPrefixes": []
    },
    "must-not-reuse-live-endpoint": {
      "description": "A live third-party endpoint of the real site (checkout, newsletter POST, plugin listing, company mailbox, legal pages, affiliate script). Never emit it in a generated page; use the page owner's own URL or a placeholder (https://example.com/...).",
      "allowedRefPrefixes": []
    },
    "may-generate-new": {
      "description": "Generic UI glyph. New artwork in the same stroke/size may be drawn; it must not contain a real logo.",
      "allowedRefPrefixes": [
        "generated",
        "owner-supplied"
      ]
    }
  },
  "pinnedPolicies": {
    "brand.logo-wordmark": "must-not-reproduce",
    "brand.logo-mark": "must-not-reproduce",
    "meta.favicon": "must-not-reproduce",
    "meta.og-image": "generated-stand-in-only",
    "logo.third-party-tool": "must-not-fabricate",
    "icon.figma-glyph": "must-not-fabricate",
    "media.hero-video": "generated-stand-in-only",
    "media.step-video": "generated-stand-in-only",
    "media.figma-panel": "generated-stand-in-only",
    "media.export-screenshot": "generated-stand-in-only",
    "media.faq-screenshot": "generated-stand-in-only",
    "media.device-mockup": "html-rebuild-only",
    "font.roobert": "licensed-font-required",
    "font.vesterbro": "licensed-font-required",
    "endpoint.checkout": "must-not-reuse-live-endpoint",
    "endpoint.newsletter-form": "must-not-reuse-live-endpoint",
    "endpoint.plugin-listing": "must-not-reuse-live-endpoint",
    "endpoint.company-mailbox": "must-not-reuse-live-endpoint",
    "endpoint.legal-pages": "must-not-reuse-live-endpoint",
    "script.affiliate": "must-not-reuse-live-endpoint"
  },
  "refRules": {
    "asset:": "registered id of the field role; allowed only where the policy lists \"asset\" (no settable role does: every original asset is proprietary or a trademark)",
    "owner-supplied:": "the page owner supplies media/marks they hold rights to (their own mark; an official third-party mark under its brand guidelines)",
    "generated:": "a newly generated stand-in, allowed only for generated-stand-in-only / may-generate-new roles"
  },
